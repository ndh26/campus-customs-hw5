# Copy to .env (same folder) and fill in. .env is git-ignored; never commit a real key.

# Course Portkey gateway key used by the agents (required to run the agent team)
PORTKEY_API_KEY=

# Optional overrides
AGENT_MODEL=gpt-5.6-luna
AGENT_REASONING_EFFORT=low
SUITE_MAX_TOKENS=150000
SUITE_MAX_DELEGATIONS=8

# Dashboard: where the frontend finds the API (read by Vite; default shown)
VITE_API_URL=http://localhost:8000
